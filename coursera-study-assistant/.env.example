# Copy to .env (never commit .env). Every value is optional.

# Course to work on (slug from the Coursera URL /learn/<slug>/...)
COURSE_SLUG=the-ai-transformation-advisor

# Chrome used for the study session. Auto-detected on Windows/macOS/Linux.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Local DevTools port the tool attaches to (bound to 127.0.0.1 by Chrome).
CDP_PORT=9222

# Finish readings / ungraded items (plugin, role play, dialogue) on Coursera by
# itself, then open the next item: click "Mark as completed", or Start Dialogue /
# Role Play / Activity -> "Use text chat" -> End -> "I don't have time...". You get a 3 s countdown to
# type another key (l, f, q) instead. Never applies to videos, practice or
# graded items. Off unless set to 1.
# AUTO_MARK_COMPLETE=1

# Save each video's transcript to local notes as soon as you open it (used by
# `npm run summary`). On unless set to 0.
# AUTO_CAPTURE=0

# --- AI study features (summary, practice quiz, ask) -----------------------
# Disabled unless AI_PROVIDER is set. Only course text you captured and your
# own questions are sent; never cookies, account data or assessment content.
# AI_PROVIDER=openai        # openai | anthropic
# AI_MODEL=                 # required for openai; anthropic defaults to claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Language for notes/quiz/answers (course terms stay in English).
STUDY_LANGUAGE=Vietnamese
