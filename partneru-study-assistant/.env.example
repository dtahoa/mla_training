# Copy to .env (never commit .env). Every value is optional.

# Program to work on (UUID from the URL /program/<id>).
# Default: OpenAI Technical Practitioner.
PROGRAM_ID=d4d206ae-aa74-4f86-b503-d5b2fbab1a0f

# Chrome used for the study session. Auto-detected on Windows/macOS/Linux.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Local DevTools port (bound to 127.0.0.1 by Chrome). 9223 so the Coursera
# tool's Chrome (9222) can stay open at the same time.
CDP_PORT=9223

# `npm run study`: click "Continue" on content cards by itself after a
# countdown (seconds) you can interrupt (p = turn off, q = stop). Never on
# video cards (Enter) or knowledge checks / quizzes (you answer them).
# Off unless set to 1.
# AUTO_ADVANCE=1
# AUTO_ADVANCE_DELAY=3

# --- AI summary (npm run summary) -------------------------------------------
# Disabled unless AI_PROVIDER is set. Only the card text saved in your notes
# is sent; never knowledge checks, the exam, cookies or account data.
# AI_PROVIDER=openai        # openai | anthropic
# AI_MODEL=                 # required for openai; anthropic defaults to claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Language of the summaries (OpenAI product names / tech terms stay in English).
STUDY_LANGUAGE=Vietnamese
